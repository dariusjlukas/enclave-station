# Copy to .env and fill in. .env is gitignored.
# Database
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=CHANGEME_generate_with_openssl_rand_hex_32
POSTGRES_DB=chatapp

# Backend tuning
SESSION_EXPIRY_HOURS=168
PUBLIC_URL=
# Max bytes per uploaded file. 0 = unlimited. Default 1 GiB.
MAX_FILE_SIZE=1073741824
DB_POOL_SIZE=10

# Optional Redis URL for horizontal WS scaling. When set, all backend
# instances must point at the same Redis. Empty = single-instance mode.
# Bring up the redis service with `docker compose --profile redis up`.
# REDIS_URL=redis://redis:6379

# Optional: stable per-instance ID. Used to filter out the instance's own
# Redis-published messages. Defaults to a random UUID at boot. For sticky
# multi-instance deployments set this to e.g. ${HOSTNAME}.
# INSTANCE_ID=

# File-blob storage backend.
#   local (default): files on local disk at UPLOAD_DIR. Single-instance only.
#   s3: S3-compatible object store shared by all backend replicas (required for
#       horizontal scaling). Works with MinIO/Garage/Ceph/Swift/AWS/R2/B2.
# To use the bundled MinIO: set STORAGE_BACKEND=s3 and the S3_* vars below, then
#   docker compose --profile minio up
# See docs/ops/object-storage.md.
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=enclave
# S3_ACCESS_KEY=CHANGEME_minio_access_key
# S3_SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
# S3_REGION=us-east-1
